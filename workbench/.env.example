APP_NAME=Refract
APP_ENV=local
APP_KEY=AckfSECXIvnK5r28GVIWUAxmbBSjTsmF
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=array
# Shared by every process, for the unique lock and the backoff of the queue drain (L2).
CACHE_STORE=file
QUEUE_CONNECTION=database

# The queue drain (L2) stores runs in Redis; run a worker for its jobs:
# vendor/bin/testbench queue:work --queue=refract
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

REFRACT_ENVIRONMENT=

LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

REFRACT_DESTINATION=langfuse
