APP_NAME=Refract
APP_ENV=local
APP_KEY=AckfSECXIvnK5r28GVIWUAxmbBSjTsmF
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=array
# Shared by every process, for the unique lock and the backoff of the queue drain (L2).
CACHE_STORE=file
QUEUE_CONNECTION=database

# The queue drain (L2) stores runs in Redis. refract:check L2 runs the scenario with
# REFRACT_DRAIN=queue, waits for the drain job to be due, then runs
# vendor/bin/testbench queue:work --queue=refract --stop-when-empty before reading Langfuse.
# For L2 over the web route, run that worker yourself.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

REFRACT_DESTINATION=langfuse

# sync, or queue (L2 always drains through the queue)
REFRACT_DRAIN=sync
REFRACT_COLLECTOR=redis
