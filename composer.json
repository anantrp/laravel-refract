{
    "name": "anantrp/laravel-refract",
    "description": "Record every Laravel AI SDK run as an OpenTelemetry trace and send it to Langfuse or any OTLP backend.",
    "type": "library",
    "keywords": ["laravel", "ai", "laravel-ai", "observability", "opentelemetry", "otlp", "langfuse", "tracing"],
    "homepage": "https://github.com/anantrp/laravel-refract",
    "license": "MIT",
    "authors": [
        {
            "name": "Anant Parmar",
            "email": "anant26692@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/anantrp/laravel-refract/issues",
        "source": "https://github.com/anantrp/laravel-refract"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.0",
        "open-telemetry/api": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.26",
        "open-telemetry/sem-conv": "~1.44.0",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Anantrp\\Refract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anantrp\\Refract\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anantrp\\Refract\\RefractServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
